#!/usr/bin/env bash
# The .proto files of the gateway work with the tools of other languages, not only with the Rust build.
#
# The Rust build compiles them with protox, which forgives what protoc and buf refuse (a call named like the type it
# returns once hid that type from protoc). So this compiles them with protoc, makes a Go client with the command the book
# gives (docs/src/gateway/bots.md, "Бот на другом языке") and builds it.
#
# Needs protoc, protoc-gen-go, protoc-gen-go-grpc and go in PATH. The CI (.github/workflows/gateway.yml) installs them.
# Writes only into a temporary directory.
set -euo pipefail
proto="$(cd "$(dirname "$0")/../crates/gateway/proto" && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

files=(brokapi/gateway/v1/gateway.proto brokapi/gateway/v1/types.proto brokapi/service/v1/service.proto)
protoc -I "$proto" --descriptor_set_out=/dev/null "${files[@]}"
echo "protoc: the .proto files compile"

cd "$work"
go mod init example.com/bot >/dev/null 2>&1
mkdir gen
m=brokapi/gateway/v1
pkg=example.com/bot/gen/$m
protoc -I "$proto" \
  --go_out=gen --go_opt=paths=source_relative --go_opt=M$m/gateway.proto=$pkg --go_opt=M$m/types.proto=$pkg \
  --go-grpc_out=gen --go-grpc_opt=paths=source_relative --go-grpc_opt=M$m/gateway.proto=$pkg --go-grpc_opt=M$m/types.proto=$pkg \
  $m/gateway.proto $m/types.proto
cat >main.go <<'EOF'
package main

import gw "example.com/bot/gen/brokapi/gateway/v1"

func main() {
	var _ gw.GatewayClient
	_ = &gw.Portfolio{}
}
EOF
go mod tidy >/dev/null
go build ./...
echo "go: the client made from the .proto files builds"
