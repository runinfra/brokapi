<!DOCTYPE HTML>
<html lang="{{ language }}" class="{{ default_theme }} sidebar-visible" dir="{{ text_direction }}">
    <head>
        <!-- Book generated using mdBook -->
        <meta charset="UTF-8">
        <title>{{ title }}</title>
        {{#if is_print }}
        <meta name="robots" content="noindex">
        {{/if}}
        {{#if base_url}}
        <base href="{{ base_url }}">
        {{/if}}


        <!-- Custom HTML head -->
        {{> head}}

        <meta name="description" content="{{ description }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#ffffff">

        {{#if favicon_svg}}
        <link rel="icon" href="{{ resource "favicon.svg" }}">
        {{/if}}
        {{#if favicon_png}}
        <link rel="shortcut icon" href="{{ resource "favicon.png" }}">
        {{/if}}
        <link rel="stylesheet" href="{{ resource "css/variables.css" }}">
        <link rel="stylesheet" href="{{ resource "css/general.css" }}">
        <link rel="stylesheet" href="{{ resource "css/chrome.css" }}">
        {{#if print_enable}}
        <link rel="stylesheet" href="{{ resource "css/print.css" }}" media="print">
        {{/if}}

        <!-- Fonts. The text font in both alphabets is fetched at once: the page is Russian, a late font shifts the layout. -->
        <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ resource "fonts/ibm-plex-sans-cyrillic-wght-normal.woff2" }}">
        <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ resource "fonts/ibm-plex-sans-latin-wght-normal.woff2" }}">
        <link rel="stylesheet" href="{{ resource "fonts/fonts.css" }}">

        <!-- Highlight.js Stylesheets -->
        <link rel="stylesheet" id="mdbook-highlight-css" href="{{ resource "highlight.css" }}">
        <link rel="stylesheet" id="mdbook-tomorrow-night-css" href="{{ resource "tomorrow-night.css" }}">
        <link rel="stylesheet" id="mdbook-ayu-highlight-css" href="{{ resource "ayu-highlight.css" }}">

        <!-- Custom theme stylesheets -->
        {{#each additional_css}}
        <link rel="stylesheet" href="{{ resource this }}">
        {{/each}}

        {{#if mathjax_support}}
        <!-- MathJax -->
        <script async src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-AMS-MML_HTMLorMML"></script>
        {{/if}}

        <!-- Provide site root and default themes to javascript -->
        <script>
            const path_to_root = "{{ path_to_root }}";
            const default_light_theme = "{{ default_theme }}";
            const default_dark_theme = "{{ preferred_dark_theme }}";
        </script>
        <!-- Start loading toc.js asap -->
        <script src="{{ resource "toc.js" }}"></script>
    </head>
    <body>
    <a class="skip-link" href="#main-content">К содержимому</a>
    <div id="mdbook-help-container">
        <div id="mdbook-help-popup">
            <h2 class="mdbook-help-title">Горячие клавиши</h2>
            <div>
                <p><kbd>←</kbd> и <kbd>→</kbd>: предыдущая и следующая глава</p>
                <p><kbd>S</kbd> или <kbd>/</kbd>: поиск по книге</p>
                <p><kbd>?</kbd>: показать эту подсказку</p>
                <p><kbd>Esc</kbd>: закрыть подсказку или поиск</p>
            </div>
        </div>
    </div>
    <div id="mdbook-body-container">
        <!-- Work around some values being stored in localStorage wrapped in quotes -->
        <script>
            try {
                let theme = localStorage.getItem('mdbook-theme');
                let sidebar = localStorage.getItem('mdbook-sidebar');

                if (theme.startsWith('"') && theme.endsWith('"')) {
                    localStorage.setItem('mdbook-theme', theme.slice(1, theme.length - 1));
                }

                if (sidebar.startsWith('"') && sidebar.endsWith('"')) {
                    localStorage.setItem('mdbook-sidebar', sidebar.slice(1, sidebar.length - 1));
                }
            } catch (e) { }
        </script>

        <!-- Set the theme before any content is loaded, prevents flash -->
        <script>
            const default_theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? default_dark_theme : default_light_theme;
            let theme;
            try { theme = localStorage.getItem('mdbook-theme'); } catch(e) { }
            if (theme === null || theme === undefined) { theme = default_theme; }
            const html = document.documentElement;
            html.classList.remove('{{ default_theme }}')
            html.classList.add(theme);
            html.classList.add("js");
        </script>

        <input type="checkbox" id="mdbook-sidebar-toggle-anchor" class="hidden">

        <!-- Hide / unhide sidebar before it is displayed -->
        <script>
            let sidebar = null;
            const sidebar_toggle = document.getElementById("mdbook-sidebar-toggle-anchor");
            if (document.body.clientWidth >= 1080) {
                try { sidebar = localStorage.getItem('mdbook-sidebar'); } catch(e) { }
                sidebar = sidebar || 'visible';
            } else {
                sidebar = 'hidden';
                sidebar_toggle.checked = false;
            }
            if (sidebar === 'visible') {
                sidebar_toggle.checked = true;
            } else {
                html.classList.remove('sidebar-visible');
            }
        </script>

        <nav id="mdbook-sidebar" class="sidebar" aria-label="Оглавление">
            <!-- populated by js -->
            <mdbook-sidebar-scrollbox class="sidebar-scrollbox"></mdbook-sidebar-scrollbox>
            <noscript>
                <iframe class="sidebar-iframe-outer" src="{{ path_to_root }}toc.html"></iframe>
            </noscript>
            <div id="mdbook-sidebar-resize-handle" class="sidebar-resize-handle">
                <div class="sidebar-resize-indicator"></div>
            </div>
        </nav>

        <div id="mdbook-page-wrapper" class="page-wrapper">

            <div class="page">
                {{> header}}
                <div id="mdbook-menu-bar-hover-placeholder"></div>
                <div id="mdbook-menu-bar" class="menu-bar sticky" role="banner">
                    <div class="left-buttons">
                        <button id="mdbook-sidebar-toggle" class="icon-button" type="button" title="Оглавление" aria-label="Оглавление" aria-controls="mdbook-sidebar">
                            {{fa "solid" "bars"}}
                        </button>
                        <button id="mdbook-theme-toggle" class="icon-button" type="button" title="Тема" aria-label="Сменить тему" aria-haspopup="true" aria-expanded="false" aria-controls="mdbook-theme-list">
                            {{fa "solid" "paintbrush"}}
                        </button>
                        <ul id="mdbook-theme-list" class="theme-popup" aria-label="Темы" role="menu">
                            <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-coal">Темная</button></li>
                            <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-light">Светлая</button></li>
                        </ul>
                        <!-- Search: Pagefind, docs/search.js builds the window. The index is made by docs/build.sh. -->
                        <button id="brokapi-search-toggle" class="icon-button search-toggle" type="button" title="Поиск (/)" aria-label="Поиск по книге" aria-haspopup="dialog" aria-keyshortcuts="/ s">
                            {{fa "solid" "magnifying-glass"}}<span class="search-toggle-text">Поиск</span>
                        </button>
                        {{#if print_enable}}
                        <a class="icon-button print-link" href="{{ path_to_root }}print.html" title="Печать книги" aria-label="Печать книги">
                            {{fa "solid" "print" "print-button"}}
                        </a>
                        {{/if}}
                    </div>

                    <div class="menu-title">{{ book_title }}</div>
                    <!-- Mark and name of brokapi lead to the site brokapi.ru (same mark as on the site). The book itself has no
                         separate link in the bar: the sidebar is its table of contents. -->
                    <div class="brand">
                        <a class="brand-home" href="https://brokapi.ru/" aria-label="brokapi, brokapi.ru">
                            <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
                                <path d="M3 8c9 0 10 8 17 8M3 16h17M3 24c9 0 10-8 17-8M20 16h4" />
                                <circle cx="27" cy="16" r="3" />
                            </svg>
                            <span class="brand-word">brokapi</span>
                        </a>
                    </div>

                    <div class="right-buttons">
                        <!-- One language for the whole site (docs/lang-tabs.js): the tabs "Rust | Python" follow it and
                             the pages that have a twin in the other language offer to move there. -->
                        <div class="lang-switch" role="group" aria-label="Язык примеров">
                            <button type="button" data-lang="rust" aria-pressed="false">Rust</button><button type="button" data-lang="python" aria-pressed="false">Python</button>
                        </div>
                        {{#if git_repository_url}}
                        <a href="{{git_repository_url}}" title="Репозиторий" aria-label="Репозиторий">
                            {{fa git_repository_icon_class git_repository_icon}}
                        </a>
                        {{/if}}
                        {{#if git_repository_edit_url}}
                        <a href="{{git_repository_edit_url}}" title="Предложить правку" aria-label="Предложить правку" rel="edit">
                            {{fa "solid" "pencil" "git-edit-button"}}
                        </a>
                        {{/if}}

                    </div>
                </div>


                <!-- Apply ARIA attributes after the sidebar and the sidebar toggle button are added to the DOM -->
                <script>
                    document.getElementById('mdbook-sidebar-toggle').setAttribute('aria-expanded', sidebar === 'visible');
                    document.getElementById('mdbook-sidebar').setAttribute('aria-hidden', sidebar !== 'visible');
                    Array.from(document.querySelectorAll('#mdbook-sidebar a')).forEach(function(link) {
                        link.setAttribute('tabIndex', sidebar === 'visible' ? 0 : -1);
                    });
                </script>

                <!-- Revision line: version and stage of the library. The version is a token: docs/brokapi_version.py stamp puts the number of Cargo.toml in after the build. The stage (the words) is changed here. -->
                <aside class="stage-wrap" aria-label="Стадия проекта"><a class="stage-strip" href="{{ path_to_root }}before-live.html"><span class="rev-ver">ред. @@BROKAPI_VERSION@@</span><span class="rev-stage"><i></i>Открытая альфа</span></a></aside>

                <div id="mdbook-content" class="content">
                    <div class="doc-grid">
                    <div class="doc-main">
                    <!-- data-pagefind-body: only the text of a chapter goes to the search index (not the print page). -->
                    <main id="main-content" tabindex="-1"{{#unless is_print}} data-pagefind-body{{/unless}}>
                        {{{ content }}}
                    </main>

                    {{#unless is_print}}
                    <!-- Back and forward: the two large cards at the foot of a chapter, they go through the borders of the parts.
                         The arrow keys of the book (book.js) use the arrows of .nav-wide-wrapper below, which are hidden by the CSS. -->
                    <nav class="pager" aria-label="Страницы книги">
                        {{#if previous}}
                        <a class="pv" rel="prev" href="{{ path_to_root }}{{previous.link}}" aria-keyshortcuts="Left"><small class="pager-label">Назад</small><strong class="pager-title">{{previous.title}}</strong></a>
                        {{/if}}
                        {{#if next}}
                        <a class="nx" rel="next prefetch" href="{{ path_to_root }}{{next.link}}" aria-keyshortcuts="Right"><small class="pager-label">Дальше</small><strong class="pager-title">{{next.title}}</strong></a>
                        {{else}}
                        <a class="nx" href="{{ path_to_root }}index.html"><small class="pager-label">Конец книги</small><strong class="pager-title">К началу</strong></a>
                        {{/if}}
                    </nav>
                    <p class="pager-hint">Листать можно клавишами Влево и Вправо.</p>
                    {{/unless}}
                    <footer class="book-foot">
                        <div class="book-foot-line">
                            <span>brokapi by <a href="https://runinfra.ru">RunInfra</a></span>
                            <!-- Opens the report form (docs/ui.js), which also shows the button: without the script there is no form. -->
                            <button class="report-error" type="button" hidden>Сообщить об ошибке</button>
                        </div>
                    </footer>
                    </div>
                    <!-- "On this page": filled by docs/ui.js from the headings of the chapter, shown on a wide screen. -->
                    <aside class="page-toc" aria-label="На этой странице" hidden></aside>
                    </div>
                </div>
            </div>

            <nav class="nav-wide-wrapper" aria-label="Переход между главами">
                {{#if previous}}
                    <a rel="prev" href="{{ path_to_root }}{{previous.link}}" class="nav-chapters previous" title="Предыдущая глава" aria-label="Предыдущая глава" aria-keyshortcuts="Left">
                        {{#if (eq ../text_direction "rtl")}}
                        {{fa "solid" "angle-right"}}
                        {{else}}
                        {{fa "solid" "angle-left"}}
                        {{/if}}
                    </a>
                {{/if}}

                {{#if next}}
                    <a rel="next prefetch" href="{{ path_to_root }}{{next.link}}" class="nav-chapters next" title="Следующая глава" aria-label="Следующая глава" aria-keyshortcuts="Right">
                        {{#if (eq text_direction "rtl")}}
                        {{fa "solid" "angle-left"}}
                        {{else}}
                        {{fa "solid" "angle-right"}}
                        {{/if}}
                    </a>
                {{/if}}
            </nav>

        </div>

        <template id=fa-eye>{{fa "solid" "eye"}}</template>
        <template id=fa-eye-slash>{{fa "solid" "eye-slash"}}</template>
        <template id=fa-copy>{{fa "regular" "copy"}}</template>
        <template id=fa-play>{{fa "solid" "play"}}</template>
        <template id=fa-clock-rotate-left>{{fa "solid" "clock-rotate-left"}}</template>

        {{#if live_reload_endpoint}}
        <!-- Livereload script (if served using the cli tool) -->
        <script>
            const wsProtocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsAddress = wsProtocol + "//" + location.host + "/" + "{{{live_reload_endpoint}}}";
            const socket = new WebSocket(wsAddress);
            socket.onmessage = function (event) {
                if (event.data === "reload") {
                    socket.close();
                    location.reload();
                }
            };

            window.onbeforeunload = function() {
                socket.close();
            }
        </script>
        {{/if}}

        {{#if playground_line_numbers}}
        <script>
            window.playground_line_numbers = true;
        </script>
        {{/if}}

        {{#if playground_copyable}}
        <script>
            window.playground_copyable = true;
        </script>
        {{/if}}

        {{#if playground_js}}
        <script src="{{ resource "ace.js" }}"></script>
        <script src="{{ resource "mode-rust.js" }}"></script>
        <script src="{{ resource "editor.js" }}"></script>
        <script src="{{ resource "theme-dawn.js" }}"></script>
        <script src="{{ resource "theme-tomorrow_night.js" }}"></script>
        {{/if}}


        <script src="{{ resource "clipboard.min.js" }}"></script>
        <script src="{{ resource "highlight.js" }}"></script>
        <script src="{{ resource "book.js" }}"></script>

        <!-- Custom JS scripts -->
        {{#each additional_js}}
        {{#if (eq this "mermaid.min.js")}}
        <!-- mermaid.min.js (2.7 MB) is not loaded here: mermaid-init.js fetches it from this address, and only on a page that has a diagram. -->
        <script type="text/plain" id="mermaid-lib" data-src="{{ resource this}}"></script>
        {{else}}
        <script src="{{ resource this}}"></script>
        {{/if}}
        {{/each}}

        {{#if is_print}}
        {{#if mathjax_support}}
        <script>
        window.addEventListener('load', function() {
            MathJax.Hub.Register.StartupHook('End', function() {
                window.setTimeout(window.print, 100);
            });
        });
        </script>
        {{else}}
        <script>
        window.addEventListener('load', function() {
            window.setTimeout(window.print, 100);
        });
        </script>
        {{/if}}
        {{/if}}

        {{#if fragment_map}}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const fragmentMap =
                    {{{fragment_map}}}
                ;
                const target = fragmentMap[window.location.hash];
                if (target) {
                    let url = new URL(target, window.location.href);
                    window.location.replace(url.href);
                }
            });
        </script>
        {{/if}}

    </div>
    </body>
</html>
